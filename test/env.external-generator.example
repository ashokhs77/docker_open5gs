# External load generator example configuration.
# Copy to .env.external-generator, edit, then source it before running:
#
#   set -a
#   . ./.env.external-generator
#   set +a
#   sudo docker compose -f docker-compose.test.yaml --profile external \
#     run --remove-orphans sipp-test-external          # 4G EPC + IMS
#   sudo docker compose -f docker-compose.test5g.yaml --profile external \
#     run --remove-orphans sipp-test-external-5g       # 5G SA + VoNR

TEST_TOPOLOGY=external
CORE_TARGET_LABEL=core-vm-lab
CORE_VM_HOST=192.168.56.5

# Generator VM address reachable from the Core/IMS VM.
# If omitted, the suite tries to auto-detect the source IP for PCSCF_IP.
LOCAL_IP=
LOAD_GENERATOR_IP=

# Use routed container IPs when the generator can reach docker_open5gs_default.
# Use the Core/IMS host IP only when the service ports are published/routed.
PCSCF_IP=172.22.1.21
PCSCF_PORT=5060
ICSCF_IP=172.22.1.19
SCSCF_IP=172.22.1.20
FREESWITCH_IP=172.22.1.150
PYHSS_IP=172.22.1.18
PYHSS_REST_PORT=8080
DNS_IP=172.22.1.15
SMSC_IP=172.22.1.33
MYSQL_IP=172.22.1.17
RTPENGINE_IP=172.22.1.14
MMSC_IP=192.168.56.5
OSMOMSC_IP=172.22.1.31
UPF_IP=172.22.1.8

# S1AP/SCTP endpoint for EPC attach load.
MME_IP=172.22.1.9
MME_PORT=36412

# --- 5G SA core NFs (only for the 5G suite:
#     docker compose -f docker-compose.test5g.yaml --profile external
#       run sipp-test-external-5g). IMS vars above are shared with 5G VoNR.
#     UERANSIM, if used, runs on the generator and dials AMF_IP:38412 (N2). ---
AMF_IP=172.22.1.10
AMF_SBI_PORT=7777
NRF_IP=172.22.1.12
SCP_IP=172.22.1.35
AUSF_IP=172.22.1.11
UDM_IP=172.22.1.13
UDR_IP=172.22.1.14
PCF_IP=172.22.1.27
BSF_IP=172.22.1.29
NSSF_IP=172.22.1.28
SMF_IP=172.22.1.7
MONGO_IP=172.22.1.2
WEBUI_IP=172.22.1.26

# Optional: make Docker evidence come from the Core/IMS Docker daemon instead
# of the generator VM daemon. Secure this endpoint; do not expose unauthenticated
# Docker TCP.
# DOCKER_HOST=tcp://192.168.56.5:2376

# Keep this enabled for honest accounting when the runner container is visible.
INCLUDE_TEST_CONTAINER_STATS=1

# Optional same-IMS softphone target for Mobile-to-IP tests.
SOFTPHONE_TARGET_URI=
SOFTPHONE_TARGET_LABEL=
SOFTPHONE_EXPECT_ANSWER=true
SOFTPHONE_CALL_DURATION=5
