<?xml version="1.0" encoding="ISO-8859-1" ?>
<!--
  UE-B (UAS): Simulates a VoLTE handset that answers incoming calls.
  Listens for INVITE, responds with 180 Ringing + 200 OK with SDP.
  Handles re-INVITEs (hold/unhold) and BYE.
-->
<scenario name="UE-B UAS - Answer Call">

  <!-- Wait for incoming INVITE -->
  <recv request="INVITE" crlf="true">
    <action>
      <ereg regexp=".*" search_in="hdr" header="From" assign_to="remote_from"/>
    </action>
  </recv>

  <!-- Send 100 Trying -->
  <send>
    <![CDATA[
      SIP/2.0 100 Trying
      [last_Via:]
      [last_From:]
      [last_To:];tag=[pid]SIPpTag01b
      [last_Call-ID:]
      [last_CSeq:]
      Content-Length: 0

    ]]>
  </send>

  <!-- Send 180 Ringing -->
  <send>
    <![CDATA[
      SIP/2.0 180 Ringing
      [last_Via:]
      [last_From:]
      [last_To:];tag=[pid]SIPpTag01b
      [last_Call-ID:]
      [last_CSeq:]
      Contact: <sip:9876541000@[local_ip]:[local_port]>
      Content-Length: 0

    ]]>
  </send>

  <pause milliseconds="1000"/>

  <!-- Send 200 OK with SDP -->
  <send retrans="500">
    <![CDATA[
      SIP/2.0 200 OK
      [last_Via:]
      [last_From:]
      [last_To:];tag=[pid]SIPpTag01b
      [last_Call-ID:]
      [last_CSeq:]
      Contact: <sip:9876541000@[local_ip]:[local_port]>
      Content-Type: application/sdp
      Content-Length: [len]

      v=0
      o=sipp 1 1 IN IP4 [local_ip]
      s=SIPp Test Call
      c=IN IP4 [local_ip]
      t=0 0
      m=audio [local_port] RTP/AVP 96 8 0
      a=rtpmap:96 AMR-WB/16000
      a=rtpmap:8 PCMA/8000
      a=rtpmap:0 PCMU/8000
      a=sendrecv
    ]]>
  </send>

  <!-- Wait for ACK -->
  <recv request="ACK" optional="true" timeout="5000"/>

  <!-- Handle in-dialog requests (re-INVITE for hold, BYE) -->
  <!-- Wait for re-INVITE (hold) or BYE -->
  <recv request="INVITE" optional="true" timeout="30000">
    <action>
      <ereg regexp=".*" search_in="hdr" header="CSeq" assign_to="reinvite_cseq"/>
    </action>
  </recv>

  <!-- If we got a re-INVITE, respond with 200 OK -->
  <send optional="true">
    <![CDATA[
      SIP/2.0 200 OK
      [last_Via:]
      [last_From:]
      [last_To:];tag=[pid]SIPpTag01b
      [last_Call-ID:]
      [last_CSeq:]
      Contact: <sip:9876541000@[local_ip]:[local_port]>
      Content-Type: application/sdp
      Content-Length: [len]

      v=0
      o=sipp 2 2 IN IP4 [local_ip]
      s=SIPp Test Call
      c=IN IP4 [local_ip]
      t=0 0
      m=audio [local_port] RTP/AVP 96 8 0
      a=rtpmap:96 AMR-WB/16000
      a=rtpmap:8 PCMA/8000
      a=rtpmap:0 PCMU/8000
      a=sendrecv
    ]]>
  </send>

  <recv request="ACK" optional="true" timeout="5000"/>

  <!-- Wait for BYE (or timeout) -->
  <recv request="BYE" timeout="60000"/>

  <send>
    <![CDATA[
      SIP/2.0 200 OK
      [last_Via:]
      [last_From:]
      [last_To:];tag=[pid]SIPpTag01b
      [last_Call-ID:]
      [last_CSeq:]
      Content-Length: 0

    ]]>
  </send>

  <ResponseTimeRepartition value="10, 20, 30, 40, 50, 100, 150, 200"/>
  <CallLengthRepartition value="10, 50, 100, 500, 1000, 5000, 10000"/>
</scenario>
