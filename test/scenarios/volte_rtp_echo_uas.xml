<?xml version="1.0" encoding="ISO-8859-1" ?>
<!--
  VoLTE RTP Echo Validation - UAS (Callee)
  Answers an incoming INVITE and enables RTP echo so SIPp reflects
  every RTP packet it receives.  Start before the UAC.

  Run with:
    sipp -sf volte_rtp_echo_uas.xml -i LOCAL_IP -p 6300 \
         -m 1 -l 1 -rtp_echo -timeout 30

  IMS_DOMAIN is replaced at runtime by run_sipp_templated() if needed.
-->
<scenario name="VoLTE RTP Echo UAS">

  <recv request="INVITE" crlf="true"/>

  <send>
    <![CDATA[
      SIP/2.0 100 Trying
      [last_Via:]
      [last_From:]
      [last_To:];tag=[pid]SIPpTag[call_number]
      [last_Call-ID:]
      [last_CSeq:]
      Content-Length: 0

    ]]>
  </send>

  <send retrans="500">
    <![CDATA[
      SIP/2.0 200 OK
      [last_Via:]
      [last_From:]
      [last_To:];tag=[pid]SIPpTag[call_number]
      [last_Call-ID:]
      [last_CSeq:]
      Contact: <sip:9876541000@[local_ip]:[local_port]>
      Content-Type: application/sdp
      Content-Length: [len]

      v=0
      o=sipp 1 1 IN IP4 [local_ip]
      s=VoLTE RTP Echo Answer
      c=IN IP4 [local_ip]
      t=0 0
      m=audio [auto_media_port] RTP/AVP 8 0
      a=rtpmap:8 PCMA/8000
      a=rtpmap:0 PCMU/8000
      a=sendrecv
    ]]>
  </send>

  <recv request="ACK" optional="true" timeout="5000"/>

  <recv request="BYE" timeout="30000"/>

  <send>
    <![CDATA[
      SIP/2.0 200 OK
      [last_Via:]
      [last_From:]
      [last_To:];tag=[pid]SIPpTag[call_number]
      [last_Call-ID:]
      [last_CSeq:]
      Content-Length: 0

    ]]>
  </send>

</scenario>
