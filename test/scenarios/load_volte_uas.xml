<?xml version="1.0" encoding="ISO-8859-1" ?>
<!--
  VoLTE Load Test - UAS (Callee) side
  Listens for incoming INVITEs, answers with 200 OK + SDP.
  Simulates UE-B receiving calls through the IMS chain.
  Handles multiple concurrent calls.

  Usage:
    sipp -sf load_volte_uas.xml -i LOCAL_IP -p 6000 (UAS mode, no target needed)
-->
<scenario name="VoLTE Load UAS">

  <!-- Wait for incoming INVITE -->
  <recv request="INVITE" crlf="true"/>

  <!-- 100 Trying -->
  <send>
    <![CDATA[
      SIP/2.0 100 Trying
      [last_Via:]
      [last_From:]
      [last_To:];tag=[pid]SIPpTag[call_number]
      [last_Call-ID:]
      [last_CSeq:]
      Content-Length: 0

    ]]>
  </send>

  <!-- 200 OK with SDP (answer the call) -->
  <send retrans="500">
    <![CDATA[
      SIP/2.0 200 OK
      [last_Via:]
      [last_From:]
      [last_To:];tag=[pid]SIPpTag[call_number]
      [last_Call-ID:]
      [last_CSeq:]
      Contact: <sip:9876541000@[local_ip]:[local_port]>
      Content-Type: application/sdp
      Content-Length: [len]

      v=0
      o=sipp 1 1 IN IP4 [local_ip]
      s=VoLTE Load Test Answer
      c=IN IP4 [local_ip]
      t=0 0
      m=audio [local_port] RTP/AVP 96 8 0
      a=rtpmap:96 AMR-WB/16000
      a=rtpmap:8 PCMA/8000
      a=rtpmap:0 PCMU/8000
      a=sendrecv
    ]]>
  </send>

  <!-- Wait for ACK -->
  <recv request="ACK" optional="true" timeout="5000"/>

  <!-- Wait for BYE (caller hangs up) -->
  <recv request="BYE" timeout="30000"/>

  <!-- 200 OK for BYE -->
  <send>
    <![CDATA[
      SIP/2.0 200 OK
      [last_Via:]
      [last_From:]
      [last_To:];tag=[pid]SIPpTag[call_number]
      [last_Call-ID:]
      [last_CSeq:]
      Content-Length: 0

    ]]>
  </send>

</scenario>
