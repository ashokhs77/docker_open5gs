<?xml version="1.0" encoding="ISO-8859-1" ?>
<!--
  Codec Negotiation Negative Test
  Sends an INVITE offering only GSM codec (PT 3) which is not in the
  IMS/P-CSCF allowed codec list.  Expects any non-200 rejection.

  Ideal: 488 Not Acceptable Here (codec explicitly rejected by endpoint)
  Also acceptable: 480 Temporarily Unavailable, 404 Not Found, 403 Forbidden,
                   500 Server Error — all mean the GSM call was NOT accepted.
  Fail: 200 OK (would mean the GSM-only SDP was accepted — codec filtering broken).

  Each 4xx/5xx response is an optional receive; a mandatory nop() at the end
  ensures the scenario completes successfully for any error response.
  The actual pass/fail assertion is done in the shell (check for no 200 OK).

  Run with:
    sipp PCSCF_IP:5060 -sf codec_mismatch_invite.xml -s CALLEE_MSISDN \
         -i LOCAL_IP -p 9301 -m 1 -l 1 -timeout 20

  IMS_DOMAIN is replaced at runtime by run_sipp_templated().
-->
<scenario name="Codec Mismatch INVITE (expect non-200)">

  <send retrans="500">
    <![CDATA[
      INVITE sip:[service]@IMS_DOMAIN SIP/2.0
      Via: SIP/2.0/UDP [local_ip]:[local_port];branch=[branch]
      Max-Forwards: 70
      From: <sip:9876540001@IMS_DOMAIN>;tag=[call_number]
      To: <sip:[service]@IMS_DOMAIN>
      Call-ID: [call_id]
      CSeq: 1 INVITE
      Contact: <sip:9876540001@[local_ip]:[local_port]>
      Content-Type: application/sdp
      Content-Length: [len]

      v=0
      o=sipp [call_number] 1 IN IP4 [local_ip]
      s=Codec Mismatch Test
      c=IN IP4 [local_ip]
      t=0 0
      m=audio [auto_media_port] RTP/AVP 3
      a=rtpmap:3 GSM/8000
      a=sendrecv
    ]]>
  </send>

  <!-- Provisional -->
  <recv response="100" optional="true" timeout="5000"/>
  <recv response="180" optional="true" timeout="3000"/>

  <!-- 401/407 challenge (auth required) — treat as non-accept -->
  <recv response="401" optional="true" timeout="3000"/>
  <recv response="407" optional="true" timeout="3000"/>

  <!-- 403 Forbidden -->
  <recv response="403" optional="true" timeout="3000"/>

  <!-- 404 Not Found (callee not registered or unknown) -->
  <recv response="404" optional="true" timeout="3000"/>

  <!-- 408 Request Timeout -->
  <recv response="408" optional="true" timeout="3000"/>

  <!-- 480 Temporarily Unavailable (not registered) -->
  <recv response="480" optional="true" timeout="8000"/>

  <!-- 488 Not Acceptable Here (ideal: codec explicitly rejected) -->
  <recv response="488" optional="true" timeout="8000"/>

  <!-- 500 / 503 Server Error -->
  <recv response="500" optional="true" timeout="3000"/>
  <recv response="503" optional="true" timeout="3000"/>

  <!-- Scenario completes here — shell asserts no 200 OK was seen -->

  <ResponseTimeRepartition value="10, 20, 50, 100, 200, 500, 1000"/>
  <CallLengthRepartition value="10, 50, 100, 500, 1000"/>
</scenario>
